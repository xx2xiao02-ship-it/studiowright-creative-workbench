{
  "manifest_version": 3,
  "name": "StudioWright 账号助手",
  "version": "1.1.1",
  "description": "仅在手动操作时同步当前账号；不自动采集或重试。",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "http://127.0.0.1:18888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:18888/*",
      "http://localhost:18888/*"
    ]
  }
}
